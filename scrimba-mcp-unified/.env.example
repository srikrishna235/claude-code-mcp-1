# Example environment variables for publishing
# Copy to .env and fill in your actual tokens

# PyPI Token (for twine upload)
# Get from: https://pypi.org/manage/account/token/
PYPI_TOKEN=pypi-AgEIcHlwaS5vcmcC...

# MCP Registry Token (automatically generated)
# Generated by: mcp-publisher login github
# Stored in: ~/.mcp_publisher_token

# GitHub Username (for registry namespace)
